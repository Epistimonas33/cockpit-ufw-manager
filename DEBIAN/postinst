#!/bin/bash
set -e

# Δικαιώματα αρχείων
chmod 755 /usr/share/cockpit/ufw-manager
chmod 644 /usr/share/cockpit/ufw-manager/*

# Ενεργοποίηση υπηρεσίας UFW
systemctl enable --now ufw >/dev/null 2>&1 || true

# Επανεκκίνηση Cockpit για να φανεί το νέο plugin
systemctl restart cockpit >/dev/null 2>&1 || true

exit 0
